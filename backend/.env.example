# 复制为 backend/.env 后填写。.env 不会进入 git。

# 模型接口地址：任何 OpenAI 兼容接口都可以
#   DeepSeek   https://api.deepseek.com
#   通义千问   https://dashscope.aliyuncs.com/compatible-mode/v1
QIANYUE_LLM_BASE_URL=https://api.deepseek.com

# 模型名，以服务商文档为准
QIANYUE_LLM_MODEL=deepseek-flash

# 你的 API Key。不填也能启动，调用模型时会提示
QIANYUE_LLM_API_KEY=

# 一次评估的输入 Token 上限（估算）。JD 加简历超过时不调用模型，补充资料超出的部分会被裁掉
# QIANYUE_LLM_INPUT_TOKEN_BUDGET=30000

# 批量评估时同时评估的岗位数上限。调太高容易触发服务商限流
# QIANYUE_MAX_CONCURRENT_JOBS=3

# 本机运行的 Embedding 和 Rerank 模型（fastembed 支持的模型名）。首次使用时下载到 data/models/
# 换了 Embedding 模型后要删掉 data/vectors/，让向量库重建
# QIANYUE_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-zh
# QIANYUE_RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8

# 联网搜索（公司研究、面试准备查面经时用）。也可以在页面的「设置」里选，那里保存过的优先。默认 ddgs，不用 Key，偶尔搜不到。
# 想更稳可以换成 bocha（博查）、zhipu（智谱）、tavily、brave、serper 或 exa，
# 把服务名和你自己申请的 Key 填在下面
# QIANYUE_SEARCH_PROVIDER=ddgs
# QIANYUE_SEARCH_API_KEY=

# 数据目录，默认是仓库根下的 data/。相对路径按仓库根算
# QIANYUE_DATA_DIR=/absolute/path/to/data

# 采集用的专用浏览器。默认自动找系统里安装的 Chrome；找不到时在这里写它的完整路径
# QIANYUE_CHROME_PATH=
# 专用浏览器的调试端口，和其他程序冲突时再改
# QIANYUE_BROWSER_PORT=9339
